{
  "protocol_version": 2,
  "methods": [
    "session.initialize",
    "session.shutdown",
    "run.cancel",
    "sync.start",
    "sync.cancel",
    "config.load",
    "config.validate",
    "config.readFile",
    "config.writeFile",
    "doctor.run",
    "credentials.list",
    "credentials.save",
    "credentials.clear",
    "startup.onboardingState",
    "startup.attention",
    "sources.capabilities",
    "playlists.list",
    "playlists.providerList",
    "playlists.show",
    "playlists.refresh",
    "playlists.saveDefinition",
    "playlists.config.read",
    "playlists.config.write",
    "freedl.config.read",
    "freedl.config.write",
    "freedl.plan.start",
    "freedl.capture.start",
    "freedl.promotionPlan.build",
    "freedl.promote.apply",
    "rekordbox.config.read",
    "rekordbox.config.write",
    "rekordbox.deps.status",
    "rekordbox.deps.ensure",
    "rekordbox.deps.reset",
    "rekordbox.inspect",
    "rekordbox.plan",
    "rekordbox.apply"
  ],
  "groups": [
    {
      "group": "session",
      "method": "session.initialize",
      "request": {"protocol_version": 2},
      "response": {"protocol_version": 2}
    },
    {
      "group": "runs",
      "method": "run.cancel",
      "request": {"run_id": "run-example"},
      "response": {"canceled": true}
    },
    {
      "group": "sync",
      "method": "sync.start",
      "request": {"source_ids": ["source-a"], "plan": true},
      "response": {"run_id": "run-example"}
    },
    {
      "group": "config",
      "method": "config.validate",
      "request": {"config": {"version": 1}},
      "response": {"valid": true}
    },
    {
      "group": "doctor",
      "method": "doctor.run",
      "request": {},
      "response": {"checks": [], "exit_code": 0}
    },
    {
      "group": "credentials",
      "method": "credentials.clear",
      "request": {"kind": "deemix_arl"},
      "response": {"cleared": true, "kind": "deemix_arl"}
    },
    {
      "group": "startup_sources",
      "method": "sources.capabilities",
      "request": {},
      "response": {"sources": []}
    },
    {
      "group": "playlists",
      "method": "playlists.show",
      "request": {"playlist_id": "favorites"},
      "response": {"definition": {}, "snapshot": {}}
    },
    {
      "group": "freedl",
      "method": "freedl.plan.start",
      "request": {"job_id": "soundcloud-free-dl"},
      "response": {"run_id": "run-example"}
    },
    {
      "group": "rekordbox",
      "method": "rekordbox.apply",
      "request": {"plan": {}, "dry_run": true},
      "response": {"run_id": "run-example"}
    }
  ]
}
